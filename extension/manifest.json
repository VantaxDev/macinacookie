{
  "manifest_version": 3,
  "name": "Macinacookie",
  "version": "1.2.0",
  "description": "Tieni i cookie sotto controllo: età osservata da 1 a 120 giorni, pulizia automatica e anteprima prima di cancellare.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Macinacookie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cookie-16.png",
      "32": "icons/cookie-32.png"
    }
  },
  "icons": {
    "16": "icons/cookie-16.png",
    "32": "icons/cookie-32.png",
    "48": "icons/cookie-48.png",
    "128": "icons/cookie-128.png"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "130",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
